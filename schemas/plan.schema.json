{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from Go wire models. Runtime also validates paths, policy conflicts, version windows, source hashes, and checksums.",
  "properties": {
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "contentEncoding": "base64",
            "type": [
              "string",
              "null"
            ]
          },
          "beforeDigest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "existed": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "manifest",
              "lockfile"
            ],
            "type": "string"
          },
          "mode": {
            "maximum": 511,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "description": "Canonical repository relative path; absolute paths, traversal and symlinks are rejected by apply.",
            "type": "string"
          },
          "updates": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "after",
          "existed",
          "kind",
          "mode",
          "path",
          "updates"
        ],
        "type": "object"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "lockfiles": {
      "type": "boolean"
    },
    "report": {
      "$ref": "report.schema.json"
    },
    "root": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "checksum",
    "files",
    "generatedAt",
    "lockfiles",
    "report",
    "root",
    "schemaVersion"
  ],
  "title": "HooNeedsUpdates plan",
  "type": "object"
}
